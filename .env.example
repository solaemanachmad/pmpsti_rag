# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/pmpsti_rag?sslmode=require

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=ganti-dengan-random-string-minimal-32-karakter

# ── LLM Backend: gemini | ollama | openai ───────────────────────
LLM_BACKEND=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# Ollama lokal:
# LLM_BACKEND=ollama
# LLM_MODEL=llama3.2

# ── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
# PORT default 7860 untuk Hugging Face Spaces
# Untuk dev lokal ubah ke: PORT=8080
PORT=7860
